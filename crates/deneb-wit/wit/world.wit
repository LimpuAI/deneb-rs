/// deneb-viz WIT world definition (v4 — shared drawing vocabulary)
///
/// v4 变更(相对 v3,canvas@2.0.0 窗口):
/// - 绘制词汇表升级至 `echodawn:canvas@2.0.0/draw`(Tier2 七通道/多轨道/
///   dash/line-cap/per-corner/font features/命令 id/hover-effect)
/// - hit-region 增 `hover: option<hover-effect>`(声明式 hover,宿主渲染)
/// - theme 增 `hover-color`(guest 侧 hover 提亮的语义色通道,取代宿主
///   lighten(0.08) 近似)
/// - 会话形状不变:constructor + 六方法零增删
///
/// v3 变更(相对 v2):
/// - 绘制词汇表(anim-*/font-desc/paint/gradient-*/draw-cmd/layer)抽取至共享包
///   `echodawn:canvas@1.0.0/draw`,本接口以 `use` 引回 —— 纯文本重组织,字段逐项一致
///
/// v2 变更(相对 v1):
/// - `chart` resource:有状态会话(constructor/update-data/resize/set-state/set-theme/render(t)/hit-regions)
/// - draw-cmd 无损化:corner-radius/stroke-width/font/paint(渐变)
/// - anim-desc:Tier 2 参数动画描述(宿主本地插值,零 wasm 调用)
/// - hit-region 附带 datum 数据(tooltip);hit-regions 移出 layer(v1 每层重复的修复)
/// - theme record 注入(修复 v1 spec.theme 被忽略、wasm 路径硬编码 DefaultTheme)
/// - 移除自由函数 render/hit-test(resource 方法取代;宿主侧 AABB 命中)
package deneb:viz@4.0.0;

interface data-parser {
    record schema-field {
        name: string,
        data-type: string,
    }

    record data-table {
        columns: list<schema-field>,
        rows: list<list<field-value>>,
    }

    variant field-value {
        numeric(f64),
        text(string),
        timestamp(f64),
        boolean(bool),
        null,
    }

    parse-csv: func(data: list<u8>) -> result<data-table, string>;
    parse-json: func(data: list<u8>) -> result<data-table, string>;
    parse-arrow: func(data: list<u8>) -> result<data-table, string>;
    parse-parquet: func(data: list<u8>) -> result<data-table, string>;
}

interface chart-renderer {
    use data-parser.{field-value};
    // 共享绘制词汇表 —— v4 起自 echodawn:canvas/draw@2.0.0 引回(定义归 echodawn 持有,双侧同步)
    use echodawn:canvas/draw@2.0.0.{anim-property, loop-mode, keyframe, anim-desc, font-desc, gradient-stop, linear-gradient, paint, draw-cmd, layer, hover-effect};

    // ---- 命中区(宿主侧 AABB,datum 供 tooltip) ----

    record hit-region {
        index: u32,
        series: option<u32>,
        bounds-x: f64,
        bounds-y: f64,
        bounds-w: f64,
        bounds-h: f64,
        datum: list<field-value>,
        /// 声明式 hover 效果(宿主对 draw-cmd.id == index 的指令采样渲染,零 wasm 调用)
        hover: option<hover-effect>,
    }

    record render-result {
        layers: list<layer>,
    }

    // ---- 交互态与动画相位 ----

    record interaction-state {
        hovered: option<u32>,
        selected: list<u32>,
    }

    // ---- 主题注入(DesignTokens 派生) ----

    record margin {
        top: f64,
        right: f64,
        bottom: f64,
        left: f64,
    }

    record theme {
        palette: list<string>,
        background: string,
        foreground: string,
        grid: string,
        axis: string,
        title-color: string,
        /// 选中项 outline 色(宿主 input_border_focus token;缺省用 foreground)
        focus-color: option<string>,
        /// hover 提亮语义色(guest set-state 提亮的基准色;缺省用宿主近似)
        hover-color: option<string>,
        font-family: string,
        base-font-size: f64,
        title-font-size: f64,
        label-font-size: f64,
        tick-font-size: f64,
        margin: margin,
    }

    // ---- 入场编排(per-item 编排在提供方插值,总时长由宿主 clip 决定) ----

    record animation-config {
        /// 宿主入场 clip 总时长(默认 500ms),stagger 归一化基准
        enter-duration-ms: option<u32>,
        /// 每项级联相位偏移(默认 24ms),级联总量 cap 400ms
        stagger-ms: option<f64>,
        /// per-item 缓动(默认 "cubic-out";支持 "linear"/"cubic-in"/"cubic-out"/"cubic-in-out")
        easing: option<string>,
        /// 动画禁用(ReducedMotion / 静态场景)
        disable: bool,
    }

    record chart-spec {
        mark: string,
        x-field: string,
        y-field: string,
        color-field: option<string>,
        open-field: option<string>,
        high-field: option<string>,
        low-field: option<string>,
        close-field: option<string>,
        theta-field: option<string>,
        size-field: option<string>,
        width: f64,
        height: f64,
        title: option<string>,
        animation: option<animation-config>,
    }

    // ---- 有状态会话 ----

    resource chart {
        constructor(spec: chart-spec, theme: option<theme>);
        update-data: func(data: list<u8>, format: string) -> result<_, string>;
        resize: func(width: f64, height: f64);
        set-state: func(state: interaction-state);
        set-theme: func(theme: theme);
        /// Tier 1 语义动画:t ∈ [0,1] 动画相位。
        /// 入场:constructor/update-data 后 t 从 0 → 1(grid/axis fade t∈[0,0.3],数据项 stagger 生长 t∈[0.1,1])。
        /// 状态过渡:set-state 后 t 从 0 → 1(高亮/置灰强度插值)。
        /// 稳态:t=1;提供方内部缓存非 Data 层。
        render: func(t: f64) -> result<render-result, string>;
        /// 命中区(几何为稳态值,resize/update-data 后更新;宿主侧 AABB 命中,零 wasm 调用)
        hit-regions: func() -> list<hit-region>;
    }
}

world deneb-viz {
    import limpuai:data/arrow-parser;
    import limpuai:data/parquet-parser;

    export data-parser;
    export chart-renderer;
}
